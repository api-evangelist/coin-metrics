{
  "item": [
    {
      "id": "821022b0-0ab0-443b-958a-c5455fa32a68",
      "name": "Chain Monitor tools",
      "description": {
        "content": "Endpoints for working with chain monitor data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "63f43f86-c407-46f6-b27f-6776371477d6",
          "name": "Transaction tracker",
          "request": {
            "name": "Transaction tracker",
            "description": {
              "content": "Returns status updates for the specified or all transactions.<br/> This endpoint can be helpful to track transaction settlement.<br/> The transaction tracker keeps the history of the transaction updates for one month since the last update.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "blockchain",
                ":asset",
                "transaction-tracker"
              ],
              "host": [
                "{{blockchain-asset-transaction-tracker-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "txids",
                  "value": "<string>,<string>",
                  "description": "Comma separated list of transaction identifiers (txid) to track."
                },
                {
                  "disabled": false,
                  "key": "replacements_for_txids",
                  "value": "<string>,<string>",
                  "description": "<b>BTC asset only.</b><br/> Comma separated list of transaction identifiers (txid) to get the corresponding replacement transactions for.<br/> Mutually exclusive with `txids`.<br/>"
                },
                {
                  "disabled": false,
                  "key": "replacements_only",
                  "value": "<boolean>",
                  "description": "<b>BTC asset only.</b><br/> Boolean indicating if the response should contain only the replacement transactions."
                },
                {
                  "disabled": false,
                  "key": "addresses",
                  "value": "<string>,<string>",
                  "description": "<b>BTC asset only.</b><br/> Comma separated list of bitcoin addresses to track transactions for. Transactions in which at least one of the addresses is either a sender or recipient will be returned.<br/> By default only transactions currently in mempool are returned. To return all associated transactions use `unconfirmed_only=false` parameter.<br/> Mutually exclusive with `txids`, `replacements_for_txids`, `replacements_for_txids` parameters."
                },
                {
                  "disabled": false,
                  "key": "unconfirmed_only",
                  "value": "<boolean>",
                  "description": "<b>BTC asset only.</b><br/> Can be used only in conjunction with `addresses` parameter. Controls whether all or only unconfirmed transactions (currently in mempool) are returned."
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<string>",
                  "description": "Start of the time interval.<br/> This field refers to the `time` field in the response.<br/> Multiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`.<br/> Inclusive by default.<br/> UTC timezone by default. `Z` suffix is optional and `timezone` parameter has a priority over it.<br/> If `start_time` is omitted, response will include time series from the **earliest** time available."
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<string>",
                  "description": "End of the time interval.<br/> This field refers to the `time` field in the response.<br/> Multiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`.<br/> Inclusive by default.<br/> UTC timezone by default. `Z` suffix is optional and `timezone` parameter has a priority over it.<br/> If `end_time` is omitted, response will include time series up to the **latest** time available."
                },
                {
                  "disabled": false,
                  "key": "start_inclusive",
                  "value": "true",
                  "description": "Inclusive or exclusive corresponding `start_*` parameters."
                },
                {
                  "disabled": false,
                  "key": "end_inclusive",
                  "value": "true",
                  "description": "Inclusive or exclusive corresponding `end_*` parameters."
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "UTC",
                  "description": "Timezone name for `start_time` and `end_time` timestamps.<br/> This parameter does not modify the output times, which are always `UTC`.<br/> Format is defined by [TZ database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "Number of items per single page of results.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "paging_from",
                  "value": "end",
                  "description": "Where does the first page start, at the start of the interval or at the end.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "false",
                  "description": "Human-readable formatting of JSON responses."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Format of the response."
                },
                {
                  "disabled": false,
                  "key": "next_page_token",
                  "value": "<string>",
                  "description": "Token for receiving the results from the next page of a query.<br/> Should not be used directly. To iterate through pages just use `next_page_url` response field."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "asset",
                  "description": "(Required) Asset name."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
