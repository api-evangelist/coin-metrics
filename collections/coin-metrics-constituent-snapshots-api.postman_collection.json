                ],
                "url": {
                  "raw": "{{baseUrl}}/constituent-snapshots/asset-metrics?metric=<string>&at_time=<string>&start_time=<string>&end_time=<string>&next_page_token=<string>&page_size=100&paging_from=end&format=json&pretty=false",
