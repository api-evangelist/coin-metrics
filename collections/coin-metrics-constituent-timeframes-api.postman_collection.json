  "item": [
    {
      "id": "5b8992a6-8855-48be-9f5c-75b1d1456872",
      "name": "Constituent Timeframes",
      "description": {
        "content": "Endpoints for getting the timeframes of various constituents",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "93580d81-338a-4260-817c-dc34e56e1257",
          "name": "Timeframes of asset metric constituents",
          "request": {
            "name": "Timeframes of asset metric constituents",
            "description": {
              "content": "Returns timeframes of asset metric constituents. \\\nResults are sorted by tuple (`start_time`, `constituent_name`), where constituent depends on a target metric. \nE.g., the `volume_trusted_spot_usd_1d` metric constituents are exchanges, \ni.e. the output will be sorted by (`start_time`, `exchange`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "constituent-timeframes",
                "asset-metrics"
              ],
              "host": [
                "{{constituent-timeframes-asset-metrics-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metric",
                  "value": "<string>",
                  "description": "(Required) Target metric name."
                },
                {
                  "disabled": false,
                  "key": "constituents",
                  "value": "<string>,<string>",
                  "description": "Comma separated list of constituents. By default all constituents are returned.\nDifferent asset metrics may have different constituents.\nFor example, constituents for `volume_trusted_spot_usd_1d` are exchanges.\n"
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<string>",
                  "description": "Start of the time interval, inclusive. \\\nMultiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`. \\\nMutually exclusive with `at_time`.\n"
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<string>",
                  "description": "End of the time interval, inclusive. \\\nMultiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`. \\\nMutually exclusive with `at_time`.\n"
                },
                {
                  "disabled": false,
                  "key": "next_page_token",
                  "value": "<string>",
                  "description": "Token for receiving the results from the next page of a query.<br/> Should not be used directly. To iterate through pages just use `next_page_url` response field."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "Number of items per single page of results.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "paging_from",
                  "value": "end",
                  "description": "Where does the first page start, at the start of the interval or at the end.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Format of the response."
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "false",
                  "description": "Human-readable formatting of JSON responses."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "api_key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            }
          },
