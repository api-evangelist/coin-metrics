{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coin Metrics API v4 Blockchain Explorer Job Jobs API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get job by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coinmetrics.io/v4/jobs",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Job identifier."
              },
              {
                "name": "pretty",
                "value": "",
                "type": "query",
                "description": "Human-readable formatting of JSON responses."
              },
              {
                "name": "include_warnings",
                "value": "",
                "type": "query",
                "description": "Flag to include warnings generated by job execution in the response."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "Returns job details by job ID. If job is not found empty result is returned."
        }
      ]
    }
  ],
  "bundled": true
}