          "name": "Taxonomy metadata for assets",
          "request": {
            "name": "Taxonomy metadata for assets",
            "description": {
              "content": "Returns Taxonomy metadata for assets.<br/> Results are ordered by tuple `version`.<br/> To fetch the next page of results use `next_page_url` JSON response field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "taxonomy-metadata",
                "assets"
              ],
              "host": [
                "{{taxonomy-metadata-assets-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Taxonomy version. Defaults to `latest` when no `*_time` parameters specified. Specify asterisk `*` in order to get all versions."
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<string>",
                  "description": "Start time of taxonomy version.<br/> Multiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`.<br/> Inclusive by default.<br/>"
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<string>",
                  "description": "End time of taxonomy version.<br/> Multiple formats of ISO 8601 are supported: `2006-01-20T00:00:00Z`, `2006-01-20T00:00:00.000Z`, `2006-01-20T00:00:00.123456Z`, `2006-01-20T00:00:00.123456789Z`, `2006-01-20`, `20060120`.<br/> Inclusive by default.<br/>"
                },
                {
                  "disabled": false,
                  "key": "start_inclusive",
                  "value": "true",
                  "description": "Inclusive or exclusive corresponding `start_*` parameters."
                },
                {
                  "disabled": false,
                  "key": "end_inclusive",
                  "value": "true",
                  "description": "Inclusive or exclusive corresponding `end_*` parameters."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "Number of items per single page of results.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "paging_from",
                  "value": "start",
                  "description": "Where does the first page start, at the start of the interval or at the end.<br/> The value of this parameter is ignored if the endpoint supports the `format` parameter and its value is set to `json_stream`."
                },
                {
                  "disabled": false,
                  "key": "next_page_token",
                  "value": "<string>",
                  "description": "Token for receiving the results from the next page of a query.<br/> Should not be used directly. To iterate through pages just use `next_page_url` response field."
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "false",
                  "description": "Human-readable formatting of JSON responses."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
